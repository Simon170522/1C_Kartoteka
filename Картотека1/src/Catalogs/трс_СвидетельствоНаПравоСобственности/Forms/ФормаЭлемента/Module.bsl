#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНаименование()
	Если Не ЗначениеЗаполнено(Объект.Наименование) Тогда
		Объект.Наименование = трс_ОперацииНедвижимости.ЗаполнитьНаименование("Свидетельство на право собственности на ", Объект.НаименованиеОбъектаНедвижимости, Объект.трс_ДатаВыдачи);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура АктивацияПоТипу()

	ОКС = Перечисления.трс_ТипНедвижимости.ОбъектКапитальногоСтроительства;
	ЕстьОКС = Ложь;
	Если Объект.ТипНедвижимости = ОКС Тогда
		ЕстьОКС = Истина;
	Иначе
		ЕстьОКС = Ложь;
	КонецЕсли;   
	ЕстьЗУ = НЕ ЕстьОКС; 
		
	Элементы.ИспользованиеЗдания.Видимость = ЕстьОКС;
	Элементы.ЦелевоеИспользование.Видимость = ЕстьОКС;
	Элементы.Назначение.Видимость = ЕстьОКС;
	Элементы.Этажность.Видимость = ЕстьОКС;
	
	Если ЕстьОКС Тогда
		Объект.КатегорияЗемель = Неопределено;
	Иначе
		Объект.ИспользованиеЗдания = Неопределено;
		Объект.ЦелевоеИспользование = Неопределено;
		Объект.Назначение = Неопределено;
		Объект.Этажность = Неопределено;
	КонецЕсли;

	Элементы.КатегорияЗемель.Видимость = ЕстьЗУ;

КонецПроцедуры // АктивацияПоТипу()

&НаСервере
Процедура ОпределитьТипНедвижимости()
	
	ВозможныеВидыОбъекта = Перечисления.трс_ВидОбъекта;

	Если ЗначениеЗаполнено(Объект.ВидОбъекта) Тогда
		Если Объект.ВидОбъекта = ВозможныеВидыОбъекта.ЗемельныйУчасток или Объект.ВидОбъекта = ВозможныеВидыОбъекта.ЧастьЗемельногоУчастка Тогда
			Объект.ТипНедвижимости = Перечисления.трс_ТипНедвижимости.ЗемельныйУчасток;
		Иначе
			Объект.ТипНедвижимости = Перечисления.трс_ТипНедвижимости.ОбъектКапитальногоСтроительства;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры // ОпределитьТипНедвижимости()

&НаСервере
Процедура АктивацияАренды()

	Аренда = Перечисления.трс_ВидПрава.Аренда;
	Субаренда = Перечисления.трс_ВидПрава.Субаренда;
	Если Объект.ВидПрава = Аренда ИЛИ Объект.ВидПрава = Субаренда Тогда
		Элементы.КонецАренды.Видимость = Истина;
	Иначе
		Элементы.КонецАренды.Видимость = Ложь;
		Объект.КонецАренды = Неопределено;
	КонецЕсли;

КонецПроцедуры // АктивацияАренды()

#КонецОбласти