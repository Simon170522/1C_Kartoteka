КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыборЗУ(Команда)

	ОтборДляФормы = Новый Структура;
	ОтборДляФормы.Вставить("ТипНедвижимости", ПолучитьТипЗУ());
	ПараметрыФормы = Новый Структура("Отбор", ОтборДляФормы);
	ОбработкаВыбора = Новый ОписаниеОповещения("ПриЗакрытииВыбораЗУ", ЭтотОбъект);
	ОткрытьФорму("Справочник.трс_НедвижимоеИмущество.ФормаВыбора", ПараметрыФормы, ЭтотОбъект, , , , ОбработкаВыбора);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДополнительныйДокумент(Команда)

	ТекущиеДанные = Элементы.ДополнительныеДокументы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные.ДополнительныйДок) Тогда
		Возврат;
	КонецЕсли;
	ПоказатьЗначение(, ТекущиеДанные.ДополнительныйДок);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОсновнойДокумент(Команда)

	ТекущиеДанные = Элементы.ОсновныеДокументы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные.ОсновнойДок) Тогда
		Возврат;
	КонецЕсли;
	ПоказатьЗначение(, ТекущиеДанные.ОсновнойДок);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПрикрепленныйФайл(Команда)

	ТекущиеДанные = Элементы.ЗакрепленныеДокументы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные["ПрикрепленныйДокумент"]) Тогда
		Возврат;
	КонецЕсли;
	ПоказатьЗначение(, ТекущиеДанные["ПрикрепленныйДокумент"]);

КонецПроцедуры

&НаКлиенте
Процедура ПреобразоватьОбъект(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Сначала запишите объект недвижимости.");
		Возврат;
	КонецЕсли;

	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ВыбывающийОбъект", Объект.Ссылка);
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	ОткрытьФорму("Документ.трс_ВыбытиеОбъекта.Форма.ФормаДокумента", ПараметрыФормы);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНедвижимостьПоКН(Команда)

	ТекущиеДанные = Элементы.СоседниеОбъекты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные["КадастровыйНомер"]) Тогда
		Возврат;
	КонецЕсли;
	СсылкаНаОбъект = ОткрытьНедвижимостьПоКННаСервере(ТекущиеДанные["КадастровыйНомер"]);
	Если СсылкаНаОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПоказатьЗначение(, СсылкаНаОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПриЗакрытииВыбораЗУ(ВыбранноеЗначение, ИсточникВыбора) Экспорт

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Объект.ЗемельныйУчасток = ВыбранноеЗначение;
	Элементы.ВыборЗУ.Видимость = Ложь;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТипЗУ()

	Возврат Перечисления.трс_ТипНедвижимости.ЗемельныйУчасток;

КонецФункции

&НаСервере
Процедура АктивацияАренды()

	Аренда = Перечисления.трс_ВидПрава.Аренда;
	Субаренда = Перечисления.трс_ВидПрава.Субаренда;
	Если Объект.ВидПрава = Аренда ИЛИ Объект.ВидПрава = Субаренда Тогда
		Элементы.КонецАренды.Видимость = Истина;
	Иначе
		Элементы.КонецАренды.Видимость = Ложь;
		Объект.КонецАренды = "";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура АктивацияПоТипу()

	ОКС = Перечисления.трс_ТипНедвижимости.ОбъектКапитальногоСтроительства;
	ЕстьОКС = (Объект.ТипНедвижимости = ОКС);
	ЕстьЗУ = НЕ ЕстьОКС;

	Элементы.ГруппаЗУ.Видимость = ЕстьОКС;
	Элементы.ИспользованиеЗдания.Видимость = ЕстьОКС;
	Элементы.ЦелевоеИспользование.Видимость = ЕстьОКС;
	Элементы.Назначение.Видимость = ЕстьОКС;
	Элементы.ГодЗавершенияСтроительства.Видимость = ЕстьОКС;
	Элементы.Этажность.Видимость = ЕстьОКС;

	Если ЕстьОКС Тогда
		Объект.КатегорияЗемель = Неопределено;
		Элементы.ВыборЗУ.Видимость = НЕ ЗначениеЗаполнено(Объект.ЗемельныйУчасток);
		Объект.Родитель = Справочники.трс_НедвижимоеИмущество.ОбъектКапитальногоСтроительства;
	КонецЕсли;

	Элементы.КатегорияЗемель.Видимость = ЕстьЗУ;

	Если ЕстьЗУ Тогда
		Объект.ЗемельныйУчасток = Неопределено;
		Объект.ИспользованиеЗдания = Неопределено;
		Объект.Родитель = Справочники.трс_НедвижимоеИмущество.ЗемельныйУчасток;
		Объект.ГодЗавершенияСтроительства = Неопределено;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОпределитьТипНедвижимости()

	Если НЕ ЗначениеЗаполнено(Объект.ВидОбъекта) Тогда
		Возврат;
	КонецЕсли;

	ВидыОбъекта = Перечисления.трс_ВидОбъекта;
	Если Объект.ВидОбъекта = ВидыОбъекта.ЗемельныйУчасток
		ИЛИ Объект.ВидОбъекта = ВидыОбъекта.ЧастьЗемельногоУчастка Тогда
		Объект.ТипНедвижимости = Перечисления.трс_ТипНедвижимости.ЗемельныйУчасток;
	Иначе
		Объект.ТипНедвижимости = Перечисления.трс_ТипНедвижимости.ОбъектКапитальногоСтроительства;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОсновноеИзВыпискиЕГРН(ВыпискаИзЕГРН)

	Если НЕ ЗначениеЗаполнено(ВыпискаИзЕГРН) Тогда
		Возврат;
	КонецЕсли;

	РеквизитыДляКопирования = "ТипНедвижимости, ИзмерениеПлощади, Площадь, Этажность, Адрес,
		|ПредКадастровыйНомер, ВидПрава, КонецАренды, КадастроваяСтоимость, ВидОбъекта,
		|ЦелевоеИспользование, Назначение, ИспользованиеЗдания, КатегорияЗемель,
		|УсловныйКадастровыйНомер, НомерГосРегистрации, ДатаГосРегистрации, Правообладатель,
		|КадастровыйНомер, ВидРазрешенногоИспользования, УчетныйНомер, ГодЗавершенияСтроительства";

	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыпискаИзЕГРН, РеквизитыДляКопирования);

	Для Каждого КлючЗначение Из ЗначенияРеквизитов Цикл
		Объект[КлючЗначение.Ключ] = КлючЗначение.Значение;
	КонецЦикла;

	Объект.ОсновнойДокумент = ВыпискаИзЕГРН;
	ЗаполнитьСписокДокументовОснований(ВыпискаИзЕГРН);

КонецПроцедуры

&НаСервере
Функция ВзятьПоследнийСвидетельствоИлиЕГРН()

	РезультатФункции = Неопределено;
	ПоследняяДата = '00010101';

	ОписанияТипов = Новый Массив;
	ОписанияТипов.Добавить(Тип("СправочникСсылка.трс_ВыпискаИзЕГРН"));
	ОписанияТипов.Добавить(Тип("СправочникСсылка.трс_СвидетельствоНаПравоСобственности"));

	Для Каждого Строка Из Объект.ОсновныеДокументы Цикл
		Если НЕ ЗначениеЗаполнено(Строка.ОсновнойДок)
			ИЛИ ОписанияТипов.Найти(ТипЗнч(Строка.ОсновнойДок)) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		РеквизитыСсылки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Строка.ОсновнойДок, "трс_ДатаВыдачи");
		ДатаВыдачи = РеквизитыСсылки.трс_ДатаВыдачи;
		Если ДатаВыдачи > ПоследняяДата Тогда
			ПоследняяДата = ДатаВыдачи;
			РезультатФункции = Строка.ОсновнойДок;
		КонецЕсли;
	КонецЦикла;

	Возврат РезультатФункции;

КонецФункции

&НаСервере
Процедура ЗаполнениеПлощадиПоДокументам()

	ЗаполнитьПлощадьПоТаблице(Объект.ОсновныеДокументы, "ОсновнойДок");
	ЗаполнитьПлощадьПоТаблице(Объект.ДополнительныеДокументы, "ДополнительныйДок");

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПлощадьПоТаблице(ТабличнаяЧасть, ИмяКолонкиДокумента)

	Для Каждого Строка Из ТабличнаяЧасть Цикл
		Документ = Строка[ИмяКолонкиДокумента];
		Если НЕ ЗначениеЗаполнено(Документ) Тогда
			Продолжить;
		КонецЕсли;
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, "Площадь");
		Если ЗначениеЗаполнено(РеквизитыДокумента.Площадь) Тогда
			Строка.ПлощадьПоДокументу = РеквизитыДокумента.Площадь;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументКомментарийВТабличныхЧастях()

	ЗаполнитьКомментарийПоТаблице(Объект.ПрикрепленныеФайлы, "ПрикрепленныйДокумент");
	ЗаполнитьКомментарийПоТаблице(Объект.ОсновныеДокументы, "ОсновнойДок");
	ЗаполнитьКомментарийПоТаблице(Объект.ДополнительныеДокументы, "ДополнительныйДок");

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКомментарийПоТаблице(ТабличнаяЧасть, ИмяКолонкиДокумента)

	Для Каждого Строка Из ТабличнаяЧасть Цикл
		Документ = Строка[ИмяКолонкиДокумента];
		Если НЕ ЗначениеЗаполнено(Документ) Тогда
			Продолжить;
		КонецЕсли;
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, "трс_Комментарий");
		Комментарий = РеквизитыДокумента.трс_Комментарий;
		Если ЗначениеЗаполнено(Комментарий) Тогда
			Строка.ДокументКомментарий = Комментарий;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокДокументовОснований(ОсновнойДокумент)

	СписокДокументовОснований.Очистить();
	Если НЕ ЗначениеЗаполнено(ОсновнойДокумент) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Строка Из ОсновнойДокумент.ДокументыОснования Цикл
		СписокДокументовОснований.Добавить(Строка.ДокументОснование);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеДокументов()

	ЗаполнитьСписокДокументовОснований(Объект.ОсновнойДокумент);

	УсловноеОформление.Элементы.Очистить();

	// Зелёный фон, если основной документ присутствует в списке документов-оснований.
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ОсновныеДокументыОсновнойДок");

	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ОсновныеДокументы.ОсновнойДок");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ЭлементОтбора.ПравоеЗначение = СписокДокументовОснований;

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.БледноЗеленый);

	// Красный фон площади по документу, если она не совпадает с площадью объекта.
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ОсновныеДокументыПлощадьПоДокументу");

	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ОсновныеДокументы.ПлощадьПоДокументу");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ЭлементОтбора.ПравоеЗначение = Объект.Площадь;

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Лосось);
	
	// Зелёный фон, если дополнительный документ присутствует в списке документов-оснований.
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДополнительныеДокументыДополнительныйДок");

	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ДополнительныеДокументы.ДополнительныйДок");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ЭлементОтбора.ПравоеЗначение = СписокДокументовОснований;

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.БледноЗеленый);

	// Красный фон площади по документу, если она не совпадает с площадью объекта.
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДополнительныеДокументыПлощадьПоДокументу");

	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ДополнительныеДокументы.ПлощадьПоДокументу");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ЭлементОтбора.ПравоеЗначение = Объект.Площадь;

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Лосось);

